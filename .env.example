# AgroIA-RMC Environment Configuration
# Copy this file to .env and fill in the actual values
# IMPORTANT: Never commit .env file to version control!

# ─── Supabase Configuration ───────────────────────────────────
# Obtain from Supabase project settings (Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Service Role Key — ONLY for server-side scripts, NEVER expose to clients
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Anthropic API ────────────────────────────────────────────
# Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── API Security (CRÍTICO) ───────────────────────────────────
# API secret key for authentication via X-API-Key header
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=your-secure-api-key-here

# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://myapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Google OAuth 2.0 (Desktop Application) ───────────────────
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ─── Google Drive Integration ─────────────────────────────────
# Google Drive folder to store downloaded PDFs
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Path to service account JSON (preferred for production)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# ─── Optional Configuration ──────────────────────────────────
# Embedding model cache directory
MODEL_CACHE_DIR=.model_cache

# Logging level
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ─── Benchmark de Motores LLM (pacote benchmark/) ─────────────
# Usadas SOMENTE pelo benchmark (offline). A API de produção NÃO exige nenhuma
# delas — a factory só valida a chave quando o motor é efetivamente instanciado.
# Claude usa ANTHROPIC_API_KEY (já definida acima).

# Llama 3.1 8B via Groq — https://console.groq.com/keys (free tier disponível)
GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1        # opcional (padrão)

# Sabiá-4 via Maritaca AI — https://plataforma.maritaca.ai (pago, BRL; requer Recarga)
MARITACA_API_KEY=...
# MARITACA_BASE_URL=https://chat.maritaca.ai/api      # opcional (padrão)
# MARITACA_MODELO=sabia-4   # default sabia-4 (sabia-3 será descontinuado em 15/07/2026)

# Gemini 2.0 Flash via Google AI Studio — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Opcionais do benchmark
# BENCHMARK_DB_SYNC=false                 # true → espelha resultados no Supabase
# BENCHMARK_MAX_TOOL_RESULT_CHARS=4000    # trunca tool_result p/ Sabiá-3 (janela 8k)
